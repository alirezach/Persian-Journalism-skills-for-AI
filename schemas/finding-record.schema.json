{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pjai:schemas:finding:0.1.0",
  "title": "PJAI finding",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "finding"
    },
    "id": {
      "type": "string",
      "pattern": "^fnd-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/privacy"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "result_statement": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/source_ref"
      },
      "minItems": 0
    },
    "datasets": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/dataset_ref"
      },
      "minItems": 0
    },
    "population_inference": {
      "type": "boolean"
    },
    "method": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "calculation_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/measure"
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "draft",
        "checked"
      ]
    },
    "verification": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "not_run",
            "reproduced",
            "independently_checked",
            "failed"
          ]
        },
        "checks": {
          "type": "array",
          "items": {
            "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/check"
          },
          "minItems": 0
        }
      },
      "required": [
        "state",
        "checks"
      ],
      "additionalProperties": false
    },
    "uncertainty": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "id",
    "record_version",
    "created_at",
    "updated_at",
    "privacy",
    "question",
    "result_statement",
    "sources",
    "datasets",
    "population_inference",
    "method",
    "calculation_ref",
    "assumptions",
    "measures",
    "status",
    "verification",
    "uncertainty",
    "limitations"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "sources": {
              "minItems": 1
            }
          }
        },
        {
          "properties": {
            "datasets": {
              "minItems": 1
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "checked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "calculation_ref": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "verification": {
            "properties": {
              "state": {
                "enum": [
                  "reproduced",
                  "independently_checked"
                ]
              },
              "checks": {
                "contains": {
                  "properties": {
                    "status": {
                      "const": "passed"
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            }
          },
          "measures": {
            "items": {
              "properties": {
                "unit": {
                  "properties": {
                    "kind": {
                      "not": {
                        "const": "unknown"
                      }
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "\\S"
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "kind": {
                            "const": "money"
                          }
                        },
                        "required": [
                          "kind"
                        ]
                      },
                      "then": {
                        "properties": {
                          "currency": {
                            "type": "string",
                            "minLength": 1,
                            "pattern": "\\S"
                          },
                          "currency_namespace": {
                            "enum": [
                              "ISO4217",
                              "project"
                            ]
                          }
                        }
                      }
                    }
                  ]
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "unit": {
                        "properties": {
                          "kind": {
                            "enum": [
                              "rate",
                              "ratio"
                            ]
                          }
                        }
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "denominator": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "\\S"
                      }
                    }
                  }
                }
              ]
            }
          }
        }
      }
    }
  ]
}
