{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pjai:schemas:claim:0.1.0",
  "title": "PJAI claim",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "claim"
    },
    "id": {
      "type": "string",
      "pattern": "^clm-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/privacy"
    },
    "statement": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "attributed_to": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "context": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "as_of": {
      "anyOf": [
        {
          "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/period"
        },
        {
          "type": "null"
        }
      ]
    },
    "priority": {
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "status": {
      "enum": [
        "unreviewed",
        "in_review",
        "verified",
        "supported_with_limits",
        "misleading",
        "contradicted",
        "unresolved"
      ]
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/evidence"
      },
      "minItems": 0
    },
    "finding_refs": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/finding_ref"
      },
      "minItems": 0
    },
    "decision": {
      "type": "object",
      "properties": {
        "reasoning": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewer": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "reviewed_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "reasoning",
        "reviewer",
        "reviewed_at"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "outstanding_checks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "id",
    "record_version",
    "created_at",
    "updated_at",
    "privacy",
    "statement",
    "attributed_to",
    "context",
    "as_of",
    "priority",
    "status",
    "evidence",
    "finding_refs",
    "decision",
    "limitations",
    "outstanding_checks"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "verified",
              "supported_with_limits",
              "misleading",
              "contradicted",
              "unresolved"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "decision": {
            "type": "object",
            "properties": {
              "reasoning": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewer": {
                "type": "string",
                "minLength": 1,
                "pattern": "\\S"
              },
              "reviewed_at": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": [
              "reasoning",
              "reviewer",
              "reviewed_at"
            ],
            "additionalProperties": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "verified"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "relation": {
                  "const": "supports"
                }
              },
              "required": [
                "relation"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "contradicted"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "contains": {
              "properties": {
                "relation": {
                  "const": "contradicts"
                }
              },
              "required": [
                "relation"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "supported_with_limits"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "limitations": {
            "minItems": 1
          },
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "misleading"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "evidence": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "unresolved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "outstanding_checks": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
