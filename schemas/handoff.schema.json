{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:pjai:schemas:handoff:0.1.0",
  "title": "PJAI handoff",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "record_type": {
      "const": "handoff"
    },
    "id": {
      "type": "string",
      "pattern": "^hnd-[A-Za-z0-9][A-Za-z0-9._-]{0,79}$"
    },
    "record_version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "privacy": {
      "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/privacy"
    },
    "from_role": {
      "enum": [
        "persian-editing",
        "humanities-translation",
        "source-verification",
        "fact-checking",
        "research-synthesis",
        "data-analysis",
        "data-visualization",
        "data-journalism",
        "human-editor"
      ]
    },
    "to_role": {
      "enum": [
        "persian-editing",
        "humanities-translation",
        "source-verification",
        "fact-checking",
        "research-synthesis",
        "data-analysis",
        "data-visualization",
        "data-journalism",
        "human-editor"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/record_ref"
      },
      "minItems": 0
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/record_ref"
      },
      "minItems": 0
    },
    "work_done": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "not_checked": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "urn:pjai:schemas:common:0.1.0#/definitions/check"
      },
      "minItems": 0
    },
    "status": {
      "enum": [
        "ready",
        "partial",
        "blocked"
      ]
    },
    "blockers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "next_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "minItems": 0
    },
    "external_actions": {
      "const": "not_authorized_by_this_record"
    }
  },
  "required": [
    "schema_version",
    "record_type",
    "id",
    "record_version",
    "created_at",
    "updated_at",
    "privacy",
    "from_role",
    "to_role",
    "scope",
    "inputs",
    "outputs",
    "work_done",
    "not_checked",
    "checks",
    "status",
    "blockers",
    "next_actions",
    "external_actions"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "ready"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blockers": {
            "minItems": 1
          },
          "next_actions": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
